# =============================================================================
# AUTOMAÇÃO AGENTIVA N2 — VARIÁVEIS DE AMBIENTE
# =============================================================================
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA versione o arquivo .env no repositório.
# Veja constitution.md para regras de segurança.
# =============================================================================

# --- ServiceNow ---
# URL base da instância ServiceNow (sem barra final)
SNOW_INSTANCE_URL=https://sua-instancia.service-now.com

# Credenciais OAuth2 (recomendado para produção)
SNOW_CLIENT_ID=seu-client-id-oauth2
SNOW_CLIENT_SECRET=seu-client-secret-oauth2

# Credenciais Basic Auth (fallback se OAuth indisponível)
SNOW_USERNAME=seu-usuario-servico
SNOW_PASSWORD=sua-senha-servico

# --- Microsoft Teams / Bot Framework ---
# Application ID do Bot registrado no Azure AD
TEAMS_APP_ID=seu-app-id-azure

# Senha/Secret do Bot no Azure AD
TEAMS_APP_PASSWORD=seu-app-password-azure

# Tenant ID do Azure AD da organização
TEAMS_TENANT_ID=seu-tenant-id-azure

# Service URL do Bot Framework (geralmente fixo para Teams)
TEAMS_SERVICE_URL=https://smba.trafficmanager.net/br/

# --- Configuração do Agente ---
# Intervalo de polling em milissegundos (padrão: 120000 = 2 minutos)
POLL_INTERVAL_MS=120000

# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# Número máximo de tickets processados por ciclo
MAX_TICKETS_PER_CYCLE=50

# Número máximo de retentativas em caso de rate limit (429)
MAX_RETRIES=3

# Delay base para backoff exponencial em milissegundos
RETRY_BASE_DELAY_MS=1000
