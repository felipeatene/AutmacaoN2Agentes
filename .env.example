# =============================================================================
# LINO — FILTRO N1 INTELIGENTE (VARIÁVEIS DE AMBIENTE)
# =============================================================================
# Copie este arquivo para .env e preencha com credenciais M2M oficiais.
# NUNCA versione o arquivo .env no repositório.
#
# Como solicitar credenciais: docs/DEPLOY-AZURE-DEVOPS.md
# Regras de segurança: constitution.md e .cursor/rules/security-auth.mdc
#
# Autenticação permitida: OAuth 2.0 ou Basic Auth (conta de serviço aprovada).
# Autenticação por sessão de navegador / cookies está PROIBIDA.
# =============================================================================

# --- ServiceNow (instância base) ---
SNOW_INSTANCE_URL=https://ibmlocaliza.service-now.com

# Credenciais legadas (fallback se SNOW_READ_* / SNOW_WRITE_* não definidos)
SNOW_CLIENT_ID=seu-client-id-oauth2
SNOW_CLIENT_SECRET=seu-client-secret-oauth2
SNOW_USERNAME=seu-usuario-servico
SNOW_PASSWORD=sua-senha-servico

# --- ServiceNow READ (polling, consultas, grupos) ---
SNOW_READ_INSTANCE_URL=https://ibmlocaliza.service-now.com
SNOW_READ_CLIENT_ID=seu-read-client-id
SNOW_READ_CLIENT_SECRET=seu-read-client-secret
SNOW_READ_USERNAME=seu-usuario-leitura
SNOW_READ_PASSWORD=sua-senha-leitura

# --- ServiceNow WRITE (work_note, tags, roteamento) ---
SNOW_WRITE_INSTANCE_URL=https://ibmlocaliza.service-now.com
SNOW_WRITE_CLIENT_ID=seu-write-client-id
SNOW_WRITE_CLIENT_SECRET=seu-write-client-secret
SNOW_WRITE_USERNAME=seu-usuario-escrita
SNOW_WRITE_PASSWORD=sua-senha-escrita

# Modo de auth WRITE: oauth | basic
SNOW_WRITE_AUTH_MODE=oauth

# TLS: true apenas em ambiente de dev com proxy corporativo (SELF_SIGNED_CERT_IN_CHAIN)
SNOW_TLS_INSECURE=false

# --- Filas de atribuição ---
SNOW_MONITOR_USER=seu.user_name
SNOW_QUEUE_FILTER_MODE=both
SNOW_EXTRA_ASSIGNMENT_GROUPS=25f28e6a87363a98ed9e85930cbb3518

# --- Microsoft Teams / Bot Framework (M2M) ---
TEAMS_APP_ID=seu-app-id-azure
TEAMS_APP_PASSWORD=seu-app-password-azure
TEAMS_TENANT_ID=3737367d-87d3-46ca-b00f-21b50c428b5e
TEAMS_SERVICE_URL=https://smba.trafficmanager.net/br/

# --- Configuração do agente Lino ---
POLL_INTERVAL_MS=120000
LOG_LEVEL=info
MAX_TICKETS_PER_CYCLE=50
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
