# =============================================================================
# DaGente Banco de Horas — variáveis de ambiente
# =============================================================================
# Copie para .env e preencha. NUNCA versione o .env.
# =============================================================================

# --- Apigee (API Gateway) ---
# Preferencial: client_credentials
APIGEE_CLIENT_ID=03b27e5b1c9bd889e014043831d17785
APIGEE_CLIENT_SECRET=seu-client-secret-apigee

# Fallback: token opaco capturado do navegador (se secret indisponível)
# APIGEE_MANUAL_TOKEN=4Lsg0Ed4uy7A9vSzPstWJv3IKwD5

# --- Azure AD / DaGente ---
# Redirect URI registrado no App Registration (padrão: localhost:8400)
# DAGENTE_REDIRECT_URI=http://localhost:8400/auth-callback

# --- Comportamento ---
# Timeout HTTP em segundos (padrão: 30)
# DAGENTE_HTTP_TIMEOUT=30

# Ativa logs DEBUG (padrão: INFO)
# DAGENTE_DEBUG=1

# Usa keyring do SO para APIGEE_CLIENT_SECRET (requer pip install keyring)
# DAGENTE_USE_KEYRING=1

# Diretório de cache de tokens (padrão: ~/.dagente_cache)
# DAGENTE_CACHE_DIR=~/.dagente_cache
